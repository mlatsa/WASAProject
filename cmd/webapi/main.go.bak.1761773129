package main
import (
	"encoding/json"
	"log"
	"math/rand"
	"net/http"
	"strconv"
	"strings"
	"sync"
	"time"
)
type User struct{ ID int64 `json:"id"`; Username string `json:"username"` }
type Conversation struct{ ID int64 `json:"id"`; Name string `json:"name"`; Members []int64 `json:"members"`; UpdatedAt int64 `json:"updated_at"`; LastText string `json:"last_text"` }
type Message struct{ ID int64 `json:"id"`; SenderID int64 `json:"sender_id"`; Text string `json:"text"`; CreatedAt int64 `json:"created_at"` }
var mu sync.Mutex
var users = map[int64]*User{}
var usernameIndex = map[string]int64{}
var nextUserID int64 = 1
var contacts = map[int64]map[int64]bool{}
var convos = map[int64]*Conversation{}
var convosByUser = map[int64]map[int64]bool{}
var messages = map[int64][]*Message{}
var nextConvoID int64 = 1
var nextMessageID int64 = 1
func writeJSON(w http.ResponseWriter, v interface{}) {
	w.Header().Set("Access-Control-Allow-Origin", "*")
	w.Header().Set("Access-Control-Allow-Methods", "GET,POST,PUT,PATCH,DELETE,OPTIONS")
	w.Header().Set("Access-Control-Allow-Headers", "Content-Type, Authorization")
	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(v)
}
func withCORS(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		if r.Method == http.MethodOptions {
			w.Header().Set("Access-Control-Allow-Origin", "*")
			w.Header().Set("Access-Control-Allow-Methods", "GET,POST,PUT,PATCH,DELETE,OPTIONS")
			w.Header().Set("Access-Control-Allow-Headers", "Content-Type, Authorization")
			w.WriteHeader(http.StatusOK)
			return
		}
		next(w, r)
	}
}
func postSession(w http.ResponseWriter, r *http.Request) {
	type req struct{ Name string `json:"name"` }
	var body req
	_ = json.NewDecoder(r.Body).Decode(&body)
	name := strings.TrimSpace(body.Name)
	if name == "" { name = "user" + strconv.Itoa(rand.Intn(9000)+1000) }
	mu.Lock(); defer mu.Unlock()
	lname := strings.ToLower(name)
	id, ok := usernameIndex[lname]
	if !ok {
		id = nextUserID; nextUserID++
		users[id] = &User{ID: id, Username: name}
		usernameIndex[lname] = id
	}
	if contacts[id] == nil { contacts[id] = map[int64]bool{} }
	if convosByUser[id] == nil { convosByUser[id] = map[int64]bool{} }
	token := "demo-" + strconv.FormatInt(id,10) + "-" + strconv.FormatInt(time.Now().Unix(),10)
	writeJSON(w, map[string]interface{}{"identifier": token, "userId": id})
}
func listUsers(w http.ResponseWriter, r *http.Request) {
	mu.Lock(); defer mu.Unlock()
	out := []*User{}
	for _, u := range users { out = append(out, &User{ID:u.ID, Username:u.Username}) }
	writeJSON(w, out)
}
func getContacts(w http.ResponseWriter, r *http.Request, uid int64) {
	mu.Lock(); defer mu.Unlock()
	set := contacts[uid]; list := []User{}
	for cid := range set { if u, ok := users[cid]; ok { list = append(list, *u) } }
	writeJSON(w, list)
}
func postContact(w http.ResponseWriter, r *http.Request, uid int64) {
	type req struct{ Username string `json:"username"` }
	var body req; _ = json.NewDecoder(r.Body).Decode(&body)
	name := strings.ToLower(strings.TrimSpace(body.Username))
	if name == "" { http.Error(w,"username required",400); return }
	mu.Lock(); defer mu.Unlock()
	cid, ok := usernameIndex[name]
	if !ok { http.Error(w,"user not found",404); return }
	if contacts[uid]==nil { contacts[uid]=map[int64]bool{} }
	contacts[uid][cid]=true
	writeJSON(w,map[string]string{"status":"ok"})
}
func deleteContact(w http.ResponseWriter, r *http.Request, uid, cid int64) {
	mu.Lock(); defer mu.Unlock()
	if contacts[uid]!=nil { delete(contacts[uid],cid) }
	writeJSON(w,map[string]string{"status":"ok"})
}
func listConvos(w http.ResponseWriter, r *http.Request, uid int64) {
	mu.Lock(); defer mu.Unlock()
	set:=convosByUser[uid]; out:=[]Conversation{}
	for cid:=range set { if c,ok:=convos[cid]; ok { out=append(out,*c) } }
	writeJSON(w,out)
}
func createConvo(w http.ResponseWriter, r *http.Request, uid int64) {
	type req struct{ Name string `json:"name"`; MemberIDs []int64 `json:"memberIds"`; MemberID *int64 `json:"memberId"` }
	var body req; _ = json.NewDecoder(r.Body).Decode(&body)
	mu.Lock(); defer mu.Unlock()
	mset:=map[int64]bool{}
	if body.MemberID!=nil { mset[*body.MemberID]=true }
	for _,id:=range body.MemberIDs { mset[id]=true }
	delete(mset,uid)
	if len(mset)==0 { http.Error(w,"cannot create conversation: no other members specified",500); return }
	members:=[]int64{uid}
	for id:=range mset { if _,ok:=users[id]; ok { members=append(members,id) } }
	cid:=nextConvoID; nextConvoID++
	c:=&Conversation{ID:cid, Name:strings.TrimSpace(body.Name), Members:members, UpdatedAt:time.Now().Unix()}
	if c.Name=="" && len(members)==2 { var other int64; for _,id:=range members { if id!=uid { other=id } }; c.Name=users[other].Username }
	convos[cid]=c
	for _,id:=range members { if convosByUser[id]==nil { convosByUser[id]=map[int64]bool{} }; convosByUser[id][cid]=true }
	writeJSON(w,c)
}
func postMessage(w http.ResponseWriter, r *http.Request, uid, cid int64) {
	type req struct{ Text string `json:"text"` }
	var body req; _ = json.NewDecoder(r.Body).Decode(&body)
	txt := strings.TrimSpace(body.Text)
	if txt=="" { http.Error(w,"text required",400); return }
	mu.Lock(); defer mu.Unlock()
	if convos[cid]==nil || !convosByUser[uid][cid] { http.Error(w,"user not a member",403); return }
	msg := &Message{ID:nextMessageID, SenderID:uid, Text:txt, CreatedAt:time.Now().Unix()}
	nextMessageID++; messages[cid]=append(messages[cid],msg)
	convos[cid].LastText=txt; convos[cid].UpdatedAt=time.Now().Unix()
	writeJSON(w,msg)
}
func wsHandler(w http.ResponseWriter,r *http.Request){w.Header().Set("Access-Control-Allow-Origin","*");w.WriteHeader(http.StatusSwitchingProtocols)}
func mustInt64(s string)(int64,bool){id,err:=strconv.ParseInt(s,10,64);return id,err==nil}
func main(){
	rand.Seed(time.Now().UnixNano())
	mux:=http.NewServeMux()
	mux.HandleFunc("/health",withCORS(func(w http.ResponseWriter,r *http.Request){writeJSON(w,map[string]string{"status":"ok"})}))
	mux.HandleFunc("/session",withCORS(func(w http.ResponseWriter,r *http.Request){if r.Method==http.MethodPost{postSession(w,r);return};http.NotFound(w,r)}))
	mux.HandleFunc("/users",withCORS(func(w http.ResponseWriter,r *http.Request){if r.Method==http.MethodGet{listUsers(w,r);return};http.NotFound(w,r)}))
	mux.HandleFunc("/users/",withCORS(func(w http.ResponseWriter,r *http.Request){
		parts:=strings.Split(strings.TrimPrefix(r.URL.Path,"/users/"),"/")
		if len(parts)==0 { http.NotFound(w,r); return }
		uid,ok:=mustInt64(parts[0]); if !ok { http.NotFound(w,r); return }
		if len(parts)==1 { http.Error(w,"Method Not Allowed",405); return }
		switch parts[1] {
		case "contacts":
			if len(parts)==2 {
				if r.Method==http.MethodGet { getContacts(w,r,uid);return }
				if r.Method==http.MethodPost{ postContact(w,r,uid);return }
			} else if len(parts)==3 && r.Method==http.MethodDelete {
				if cid,ok:=mustInt64(parts[2]);ok{deleteContact(w,r,uid,cid);return}
			}
		case "conversations":
			if len(parts)==2 {
				if r.Method==http.MethodGet { listConvos(w,r,uid);return }
				if r.Method==http.MethodPost{ createConvo(w,r,uid);return }
			} else if len(parts)>=3 {
				cid,ok:=mustInt64(parts[2]); if !ok{http.NotFound(w,r);return}
				if len(parts)==4 && parts[3]=="messages" && r.Method==http.MethodPost {
					postMessage(w,r,uid,cid);return
				}
			}
		}
		http.NotFound(w,r)
	}))
	mux.HandleFunc("/ws",wsHandler)
	log.Println("demo mode enabled; listening on :3000")
	log.Fatal(http.ListenAndServe(":3000",mux))
}
