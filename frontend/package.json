{
  "name": "wasa-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "generate": "openapi --input openapi.yaml --output src/api/generated --client axios",
    "prepare": "husky install"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.21.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "openapi-typescript-codegen": "^0.24.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vue-tsc": "^1.8.25",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,json,css,md}": [
      "prettier --write",
      "eslint --fix --ext .ts,.tsx,.vue"
    ]
  }
}
